From 0586178cda6a6b78e750697ff50a564882eef337 Mon Sep 17 00:00:00 2001
From: Matthew Hollis <matt@hollisorganization.com>
Date: Thu, 12 Nov 2026 19:18:58 -0800
Subject: [PATCH] Animate the supplied Hivemind logo during app handoffs

---
 docs/iv-workspace.md                         |   2 ++
 src/renderer/src/assets/hivemind-logo.png    | Bin 0 -> 381981 bytes
 src/renderer/src/components/HivemindMark.css |  24 +++++++++++++++++++
 src/renderer/src/components/HivemindMark.jsx |  16 +++++++++++++
 src/renderer/src/components/IVWorkspace.jsx  |  21 +++++++++-------
 5 files changed, 54 insertions(+), 9 deletions(-)
 create mode 100644 src/renderer/src/assets/hivemind-logo.png
 create mode 100644 src/renderer/src/components/HivemindMark.css
 create mode 100644 src/renderer/src/components/HivemindMark.jsx

diff --git a/docs/iv-workspace.md b/docs/iv-workspace.md
index edb625e..e6a8674 100644
--- a/docs/iv-workspace.md
+++ b/docs/iv-workspace.md
@@ -42,3 +42,5 @@ Back up the three native profiles before installation. Outreach's native schema
 Next phases: selecting existing Studio library outputs without a file picker, an app-wide shared asset browser, progress callbacks from generation/publishing, then optional account and cross-device synchronization.
 
 Hivemind is the shared workspace name across all three products. Existing internal IDs, app links and the legacy IV Workspace storage folder are retained so saved brands and handoffs remain available. Studio builds and their source patches stay private.
+
+Hivemind uses the supplied IV eye/infinity logo unchanged. A short animated mark accompanies handoffs and draft preparation; reduced-motion mode uses a static indicator. Logo and transitions do not change action permissions.
diff --git a/src/renderer/src/assets/hivemind-logo.png b/src/renderer/src/assets/hivemind-logo.png
new file mode 100644
index 0000000000000000000000000000000000000000..1839683dc96378a555db86e190208f89587e5e82
