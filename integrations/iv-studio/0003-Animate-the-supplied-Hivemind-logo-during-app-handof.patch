diff --git a/src/renderer/src/components/HivemindMark.css b/src/renderer/src/components/HivemindMark.css
new file mode 100644
index 0000000..8ab5f01
--- /dev/null
+++ b/src/renderer/src/components/HivemindMark.css
@@ -0,0 +1,24 @@
+.hm-mark{position:relative;display:inline-grid;place-items:center;isolation:isolate;width:96px;height:96px;flex-shrink:0;vertical-align:middle}
+.hm-mark img{position:relative;z-index:2;display:block;width:100%;height:100%;object-fit:contain;user-select:none}
+.hm-aura{position:absolute;inset:12%;border-radius:50%;background:radial-gradient(ellipse,#c9548055,transparent 72%);opacity:.5;pointer-events:none}
+.hm-orbit{position:absolute;inset:3%;border:1px solid #dc9db522;border-radius:50%;opacity:.5;pointer-events:none}
+.hm-active img{animation:hm-breathe 3.8s cubic-bezier(.37,0,.63,1) infinite}
+.hm-active .hm-aura{animation:hm-glow 3.8s ease-in-out infinite}
+.hm-small{width:26px;height:22px}.hm-small .hm-aura,.hm-small .hm-orbit{display:none}
+.hm-large{width:240px;height:240px;max-width:55vw;max-height:55vw}
+.hm-large .hm-orbit{border-top-color:#efafc9;border-right-color:#efafc966;animation:hm-orbit 3.2s linear infinite}
+.hm-large .hm-orbit:after{content:'';position:absolute;width:5px;height:5px;left:14%;top:13%;border-radius:50%;background:#ffe4ed;box-shadow:0 0 14px #ffafcf}
+.hm-loading{position:fixed;inset:0;z-index:200001;display:grid;place-items:center;background:#100b13e8;pointer-events:none;-webkit-app-region:no-drag;animation:hm-arrive .18s ease-out}
+.hm-loading-card{display:flex;flex-direction:column;align-items:center;text-align:center;color:#fff2f7;font-family:inherit;padding:24px;max-width:90vw}
+.hm-loading-card strong{font-size:30px;font-weight:600;letter-spacing:-.04em;margin-top:-15px}
+.hm-loading-card p{font-size:14px;color:#dfc5d1;margin:10px 0 23px;line-height:1.5}
+.hm-loading-line{width:100px;height:2px;overflow:hidden;background:#74405766;border-radius:2px}
+.hm-loading-line:after{content:'';display:block;width:45%;height:100%;background:#f4bfd6;animation:hm-travel 1.5s ease-in-out infinite}
+.ivw-brand-heading{display:flex;align-items:center;gap:17px}.ivw-brand-heading .hm-mark{margin-block:-9px}
+@keyframes hm-breathe{0%,100%{transform:scale(.97);opacity:.82}50%{transform:scale(1);opacity:1}}
+@keyframes hm-glow{0%,100%{transform:scale(.94);opacity:.35}50%{transform:scale(1.12);opacity:.8}}
+@keyframes hm-orbit{to{transform:rotate(360deg)}}
+@keyframes hm-travel{0%{transform:translateX(-110%)}100%{transform:translateX(330%)}}
+@keyframes hm-arrive{from{opacity:0}to{opacity:1}}
+@media(max-width:760px){.ivw-brand-heading{gap:8px}.ivw-brand-heading .hm-mark{width:66px;height:66px}}
+@media(prefers-reduced-motion:reduce){.hm-mark img,.hm-aura,.hm-orbit,.hm-loading,.hm-loading-line:after{animation:none!important;transform:none!important;opacity:1}.hm-loading-line:after{width:100%;background:#d1a4b8}}
diff --git a/src/renderer/src/components/HivemindMark.jsx b/src/renderer/src/components/HivemindMark.jsx
new file mode 100644
index 0000000..9269788
--- /dev/null
+++ b/src/renderer/src/components/HivemindMark.jsx
@@ -0,0 +1,16 @@
+import { createPortal } from 'react-dom'
+import logo from '../assets/hivemind-logo.png'
+import './HivemindMark.css'
+
+// The supplied logo is used unchanged. Motion belongs to its surrounding UI.
+export function HivemindMark({ active = false, size = 'normal' }) {
+  return <span className={`hm-mark hm-${size}${active ? ' hm-active' : ''}`} aria-hidden="true"><span className="hm-aura"/><span className="hm-orbit"/><img src={logo} alt="" draggable="false"/></span>
+}
+
+export function HivemindLoading({ label }) {
+  return label ? createPortal(<div className="hm-loading" role="status" aria-live="polite" aria-atomic="true"><div className="hm-loading-card"><HivemindMark active size="large"/><strong>Hivemind</strong><p>{label}</p><span className="hm-loading-line" aria-hidden="true"/></div></div>, document.body) : null
+}
+
+// One short visual beat for an app handoff, concurrent with the actual work.
+// No progress percentage or completion is invented, and errors are immediate.
+export const handoffBeat = () => new Promise(resolve => setTimeout(resolve, window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 480))
