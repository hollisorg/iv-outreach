+      this.db.prepare('insert into handoffs values(?,?,?)').run(h.id, dedupe, JSON.stringify(h)); return h
+    })
+  }
+  receipt(id, value) {
+    return this.tx(() => {
+      const h = this.handoff(id); if (h.target !== this.appId) throw Error('Open this handoff in its receiving app.')
