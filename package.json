{
  "name": "fitscout",
  "productName": "IV Outreach",
  "version": "0.12.4",
  "description": "Desktop lead finder: describe your ideal customer, Claude finds and researches matching businesses, drafts personal outreach for your approval, and ranks who replies.",
  "author": "The Hollis Organization",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "hivemind:dev": "electron-vite dev --config apps/hivemind/electron.vite.config.mjs --entry apps/hivemind",
    "hivemind:build": "electron-vite build --config apps/hivemind/electron.vite.config.mjs",
    "hivemind:dist": "npm run hivemind:build && electron-builder --projectDir apps/hivemind --win --x64 --publish never",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "mcp": "node src/mcp/server.js",
    "premium:server": "npm --prefix server start",
    "premium:demo": "node scripts/premium-demo.mjs",
    "premium:check": "node scripts/premium-ui-check.mjs",
    "chat-smoke": "node scripts/chat-smoke.mjs",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never",
    "premium:local": "node server/local-runner.mjs",
    "vendor:restore": "node scripts/restore-vendor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "chrome-launcher": "1.2.3",
    "electron-updater": "6.8.11",
    "imapflow": "^2.11.0",
    "lighthouse": "13.6.0",
    "linkedom": "0.18.15",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "rss-parser": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.4",
    "vite": "^8.3.4"
  },
  "main": "./out/main/index.js",
  "build": {
    "appId": "org.hollis.fitscout",
    "productName": "IV Outreach",
    "copyright": "(c) 2026 The Hollis Organization",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "to": "vendor",
        "from": "vendor",
        "filter": [
          "gmaps/**",
          "wmn/**",
          "README.md"
        ]
      },
      {
        "to": "icon.png",
        "from": "build/icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IV-Outreach-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hollisorg",
        "repo": "iv-outreach",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Hivemind handoff",
        "schemes": [
          "iv-outreach"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hollisorg/iv-outreach.git"
  }
}
