{
  "name": "iv-hivemind",
  "productName": "IV Hivemind",
  "version": "0.7.3",
  "description": "The desktop overlay for IV Outreach, IV Studio, IV Signal, IV Chat, IV Voice and IV Downloader.",
  "author": "The Hollis Organization",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "build": {
    "appId": "org.hollis.hivemind",
    "electronVersion": "44.9.1",
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "publish": [{ "provider": "github", "owner": "hollisorg", "repo": "iv-hivemind-releases", "releaseType": "release" }],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IV-Hivemind-Setup.exe",
      "shortcutName": "IV Hivemind"
    }
  }
}
