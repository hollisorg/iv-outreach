{
  "name": "iv-hivemind",
  "productName": "IV Hivemind",
  "version": "0.7.1",
  "description": "The desktop overlay for IV Outreach, IV Studio, IV Signal, IV Chat, IV Voice and IV Keys.",
  "author": "The Hollis Organization",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "build": {
    "appId": "org.hollis.hivemind",
    "electronVersion": "44.9.1",
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IV-Hivemind-Setup-${version}.exe",
      "shortcutName": "IV Hivemind"
    }
  }
}
