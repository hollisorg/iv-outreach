# Copy to .env on the SERVER only. Never ship service keys in the desktop installer.
IV_PUBLIC_URL=http://127.0.0.1:4319
HOST=127.0.0.1
PORT=4319
IV_BILLING_DB=./data/premium.db
IV_BILLING_LIVE=false
# Your Stripe account and the two prices (test mode until live billing is set up).
STRIPE_ACCOUNT_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_TOPUP_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IV_MONTHLY_CREDITS=500
IV_TOPUP_CREDITS=100
IV_PREMIUM_CENTS=4900
IV_TOPUP_CENTS=1000
# Configure Supabase email template to include the OTP token, not only a link.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Keep paid providers off until credentials, commercial rights and budget are set.
IV_PROVIDER_CONTRACTS_APPROVED=false
IV_PROVIDER_MONTHLY_BUDGET_MICROS=0
BOUNCER_API_KEY=
BETTERCONTACT_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
EXA_API_KEY=
